{
  "info": {
    "name": "DevBoard API",
    "description": "DevBoard developer project management API collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "project_id", "value": "1" },
    { "key": "task_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"TestPass123!\",\n  \"password_confirm\": \"TestPass123!\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\"\n}"
            },
            "url": "{{base_url}}/auth/register/"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access) pm.collectionVariables.set('access_token', res.access);",
                  "if (res.refresh) pm.collectionVariables.set('refresh_token', res.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"TestPass123!\"\n}"
            },
            "url": "{{base_url}}/auth/login/"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/refresh/"
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/auth/me/"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["const res = pm.response.json(); if (res.id) pm.collectionVariables.set('project_id', res.id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My DevBoard App\",\n  \"description\": \"A project management platform\",\n  \"status\": \"building\",\n  \"tech_stack\": \"React, Django, SQLite\",\n  \"github_url\": \"https://github.com/testuser/devboard\",\n  \"live_url\": \"http://localhost:5173\"\n}"
            },
            "url": "{{base_url}}/projects/"
          }
        },
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/projects/?status=building&search=dev"
          }
        },
        {
          "name": "Get Project",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/projects/{{project_id}}/"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["const res = pm.response.json(); if (res.id) pm.collectionVariables.set('task_id', res.id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project\": {{project_id}},\n  \"title\": \"Setup authentication\",\n  \"description\": \"Implement JWT login and register\",\n  \"status\": \"in_progress\",\n  \"priority\": \"high\",\n  \"deadline\": \"2026-06-01\"\n}"
            },
            "url": "{{base_url}}/tasks/"
          }
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/tasks/?project={{project_id}}&priority=high"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/dashboard/stats/"
          }
        }
      ]
    },
    {
      "name": "GitHub",
      "item": [
        {
          "name": "Fetch GitHub Repos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/github/repos/?username=octocat"
          }
        },
        {
          "name": "Import GitHub Repo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hello-World\",\n  \"description\": \"My first repo\",\n  \"html_url\": \"https://github.com/octocat/Hello-World\",\n  \"language\": \"JavaScript\",\n  \"stars\": 100,\n  \"forks\": 20\n}"
            },
            "url": "{{base_url}}/github/import/"
          }
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "Public Portfolio",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/public/testuser/"
          }
        }
      ]
    }
  ]
}
